APP_NAME="Plaza Local"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
TRUSTED_PROXIES=null

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# En staging: LOG_STACK=daily,slack y configura el webhook para alertas externas.
LOG_SLACK_WEBHOOK_URL=
OPERATIONS_ALERT_EMAIL=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=plaza_local_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Fotos/videos publicos y expedientes privados. En nube cambia ambos discos.
MARKETPLACE_MEDIA_DISK=public
MARKETPLACE_PRIVATE_DISK=local
CLOUD_STORAGE_ACCESS_KEY=
CLOUD_STORAGE_SECRET_KEY=
CLOUD_STORAGE_REGION=auto
CLOUD_STORAGE_BUCKET=
CLOUD_STORAGE_PRIVATE_BUCKET=
CLOUD_STORAGE_URL=
CLOUD_STORAGE_ENDPOINT=
CLOUD_STORAGE_PATH_STYLE=false
# Solo local/testing. En staging/producción se reemplaza por la pasarela real.
MARKETPLACE_PAYMENT_DRIVER=fake
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Checkout Pro para cobros propios de Plaza Local (promociones, anuncios, etc.).
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SANDBOX=true
MARKETPLACE_ALLOW_FAKE_PAYMENTS=false
MARKETPLACE_RESERVATION_MINUTES=20
MARKETPLACE_PUBLICATION_DRAFT_DAYS=30
MARKETPLACE_NEGOTIATION_DAYS=7
MARKETPLACE_NEGOTIATION_MAX_EXTENSIONS=1
MARKETPLACE_NEGOTIATION_EXTENSION_WINDOW_DAYS=2
MARKETPLACE_NEGOTIATION_RETENTION_MONTHS=3
MARKETPLACE_AGREEMENT_CONVERSATION_RETENTION_MONTHS=6
MARKETPLACE_BUSINESS_TIMEZONE=America/Mexico_City

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
